{
  "name": "@norma/core",
  "version": "0.1.0",
  "description": "Deterministic proportional geometry core for the Norma MVP.",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "files": [
    "dist/src/**/*.d.ts",
    "dist/src/**/*.js",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "norma:report": "node bin/norma-core-report.mjs",
    "norma:analyze": "npm run build && node bin/norma-cli.mjs analyze",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
